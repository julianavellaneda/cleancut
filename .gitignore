# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Claude Code local settings (per-machine, not shared)
.claude/settings.local.json

# macOS
.AppleDouble
.LSOverride
._*

# Audio files (if you want to keep transcripts but not raw audio)
*.mp3
*.wav
*.m4a
*.flac
*.aac
*.aiff

# Build and output files
dist/
build/

# SQLite database
*.db

# Backend uploads/exports (keep .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep
backend/exports/*
!backend/exports/.gitkeep

# Node
node_modules/
.next/
out/

# Written by `next dev` on every run, and re-created if deleted. Generated
# tooling notes rather than anything this project decided, so they stay local.
frontend/AGENTS.md
frontend/CLAUDE.md

# JSON output files (not package.json etc)
*_violations.json

# Demo fixture — must survive the *.mp3 and *_violations.json rules above
!tests/fixtures/demo/*.mp3
!tests/fixtures/demo/expected_violations.json
tests/fixtures/demo/.cache/

# Screencast originals: re-encodable, kept local only. The H.264 captures commit.
docs/demo/captures/raw/

# playwright-cli session state
.playwright-cli/

# Exported demo result, handed to the video edit as a loose asset
!docs/demo/*.mp3
