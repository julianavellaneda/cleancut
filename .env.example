# Which model analyses the transcript, as "provider:model". The provider picks
# which key below is the one that matters; a key for the other provider is
# ignored. Blank uses openai:gpt-4o.
#   CLEANCUT_MODEL=openai:gpt-4o
#   CLEANCUT_MODEL=anthropic:claude-opus-5
CLEANCUT_MODEL=
OPENAI_API_KEY=your_key_here
ANTHROPIC_API_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000/api
CORS_ORIGINS=http://localhost:3000
DATABASE_PATH=

# Upload guardrails (optional)
MAX_UPLOAD_MB=500
MAX_DURATION_MINUTES=120

# Shared secret for the destructive admin routes (reset-database, clear-storage,
# reset-all). Leave blank to leave them open, which is fine on localhost. Set it
# before exposing the API to anything else; requests then need X-Admin-Token.
ADMIN_TOKEN=

# Delete jobs, uploads and exports older than this many hours. Blank (the
# default) keeps everything forever, which is what you want on your own machine.
# Set it on anything shared or deployed. Jobs still in the pipeline are never
# collected, however old they are.
RETENTION_HOURS=
RETENTION_SWEEP_MINUTES=15

# Set to 1 to boot even when the model API key or ffmpeg is missing. Jobs will fail.
SKIP_PREFLIGHT=
