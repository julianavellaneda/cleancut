# Which model analyses the transcript, as "provider:model". The provider picks
# which key below is the one that matters; a key for the other provider is
# ignored. Blank uses openai:gpt-4o.
#   CLEANCUT_MODEL=openai:gpt-4o
#   CLEANCUT_MODEL=anthropic:claude-opus-5
CLEANCUT_MODEL=
OPENAI_API_KEY=your_key_here
ANTHROPIC_API_KEY=

# Where the frontend's own server finds the backend. The browser only ever
# calls the frontend's /api, which is proxied here, so nothing about the
# backend's address is compiled into the page. Blank means
# http://localhost:8000; Compose sets http://backend:8000 for itself.
BACKEND_ORIGIN=

# Only if you want the browser to call the backend directly instead, skipping
# the proxy. That request is cross-origin, so CORS_ORIGINS below has to name the
# frontend - and this value is compiled into the build, so it cannot be changed
# without rebuilding.
#   NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_API_URL=

# Which interface start.sh and Docker Compose bind to. Blank means 127.0.0.1:
# reachable from this machine only. (Running the backend or frontend dev
# server by hand instead doesn't read this variable - see SECURITY.md.)
# Everything except the admin wipes is unauthenticated - the jobs list, the
# original recording, the transcript and the export - so opening the port to
# a network is a decision you have to type. Set 0.0.0.0 to do it, and put a
# reverse proxy that authenticates in front. ALLOW_UNAUTHENTICATED_ADMIN below
# is ignored once this is anything but loopback.
CLEANCUT_HOST=
CORS_ORIGINS=http://localhost:3000
DATABASE_PATH=

# Upload guardrails (optional)
MAX_UPLOAD_MB=500
MAX_DURATION_MINUTES=120

# Dead-air detection (optional). A gap only counts as silence when both an RMS
# level pass and the transcript agree. DEAD_AIR_FLOOR_DB is the dBFS level
# below which audio counts as silence; blank means -50.0. DEAD_AIR_MIN_SECONDS
# is the shortest quiet span worth suggesting; blank, zero, or negative all
# mean 0.75.
DEAD_AIR_FLOOR_DB=
DEAD_AIR_MIN_SECONDS=

# Shared secret for the destructive admin routes (reset-database, clear-storage,
# reset-all). Blank disables those three routes entirely - they answer 503 until
# you set a token here and send it as X-Admin-Token. Generate one with
# `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`.
ADMIN_TOKEN=

# Set to 1 to leave the destructive admin routes open with no token at all, the
# way they used to be. Only on a machine you control: anything that can reach
# the port can then wipe every job and every file. Ignored when ADMIN_TOKEN is
# set - a configured gate is never weakened by this flag.
ALLOW_UNAUTHENTICATED_ADMIN=

# Delete jobs, uploads and exports older than this many hours. Blank (the
# default) keeps everything forever, which is what you want on your own machine.
# Set it on anything shared or deployed. Jobs still in the pipeline are never
# collected, however old they are.
RETENTION_HOURS=
RETENTION_SWEEP_MINUTES=15

# Set to 1 to boot even when the model API key or ffmpeg is missing. Jobs will fail.
SKIP_PREFLIGHT=
